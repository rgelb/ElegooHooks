<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NativeBridgePath>..\..\native\artifacts\$(Configuration)\elegoo_link_bridge.dll</NativeBridgePath>
    <NativeBridgePath Condition="!Exists('$(NativeBridgePath)') and Exists('..\..\native\artifacts\Release\elegoo_link_bridge.dll')">..\..\native\artifacts\Release\elegoo_link_bridge.dll</NativeBridgePath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElegooLink.Desktop.Core\ElegooLink.Desktop.Core.csproj" />
    <ProjectReference Include="..\ElegooLink.Events\ElegooLink.Events.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="MainForm.Designer.cs">
      <DependentUpon>MainForm.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="MainForm.resx">
      <DependentUpon>MainForm.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>

    <Compile Update="AddPrinterDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="AddPrinterDialog.Designer.cs">
      <DependentUpon>AddPrinterDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AddPrinterDialog.resx">
      <DependentUpon>AddPrinterDialog.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>

    <Compile Update="AutomationSettingsDialog.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="AutomationSettingsDialog.Designer.cs">
      <DependentUpon>AutomationSettingsDialog.cs</DependentUpon>
    </Compile>
    <EmbeddedResource Update="AutomationSettingsDialog.resx">
      <DependentUpon>AutomationSettingsDialog.cs</DependentUpon>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="$(NativeBridgePath)"
          Link="elegoo_link_bridge.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('$(NativeBridgePath)')" />
  </ItemGroup>

  <Target Name="WarnWhenNativeBridgeIsMissing"
          BeforeTargets="Build"
          Condition="!Exists('$(NativeBridgePath)')">
    <Warning Text="The Elegoo Link native bridge is missing. Run scripts\build.ps1 before starting the desktop application." />
  </Target>
</Project>
